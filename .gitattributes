# Auto-detect text files and normalize to LF
* text=auto

# Source files — always LF
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf

# Build system — always LF
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.in text eol=lf

# Scripts — LF on all platforms
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts — CRLF on checkout
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Documentation — LF
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# LaTeX
*.tex text eol=lf
*.sty text eol=lf
*.bib text eol=lf

# Binary files
*.pdf binary
*.exe binary
*.dll binary
*.lib binary
*.so binary
*.a binary
*.o binary
*.obj binary
*.pdb binary
*.ilk binary
*.exp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Build artifacts — excluded from git
build/ linguist-generated
build/** linguist-generated
*.exe linguist-generated
*.dll linguist-generated
*.lib linguist-generated
*.pdb linguist-generated
*.ilk linguist-generated
coverage/ linguist-generated

# Generated config
quant_config.h linguist-generated
